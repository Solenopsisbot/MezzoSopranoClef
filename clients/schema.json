{
  "protocol": 2,
  "server": "MezzoSopranoClef",
  "auth": {
    "requiredWhen": "control.authToken is set (welcome.requiresAuth = true)",
    "handshake": "{\"cmd\":\"hello\",\"args\":{\"token\":\"...\"}}"
  },
  "envelope": {
    "request": "{id?, cmd, args?}",
    "response": "{id?, ok:true, result} | {id?, ok:false, code, error}",
    "event": "{event, data}"
  },
  "commands": [
    {
      "name": "ping",
      "summary": "liveness check",
      "args": [],
      "result": "{pong,time}"
    },
    {
      "name": "help",
      "summary": "list all commands",
      "args": [],
      "result": "{<command>:<summary>,...}"
    },
    {
      "name": "schema",
      "summary": "machine-readable API contract: commands+args, events+fields, error codes, protocol version",
      "args": [],
      "result": "{protocol,server,auth,envelope,commands,events,errors}"
    },
    {
      "name": "stats",
      "summary": "runtime perf counters: process CPU time, suppressed sound work, skipped frames",
      "args": [],
      "result": "{uptimeMs,cpuMs?,soundsSuppressed,skippedFrames,commandsHandled,commandsFailed,commandAvgMs,disableSound,noGl,muteAudio}"
    },
    {
      "name": "optimize",
      "summary": "toggle the muted-sound short-circuit at runtime {sound?}",
      "args": [
        {
          "name": "sound",
          "type": "bool",
          "required": false
        }
      ],
      "result": "{disableSound}"
    },
    {
      "name": "subscribe",
      "summary": "stream events to this connection {events:[...] or omit for all}",
      "args": [
        {
          "name": "events",
          "type": "string[]",
          "required": false
        }
      ],
      "result": "{subscribed:[...]}"
    },
    {
      "name": "unsubscribe",
      "summary": "stop streaming events to this connection",
      "args": [],
      "result": "{unsubscribed}"
    },
    {
      "name": "events",
      "summary": "list every event type you can subscribe to",
      "args": [],
      "result": "{events:{<name>:<desc>},subscribeAll}"
    },
    {
      "name": "status",
      "summary": "bot, world and player status",
      "args": [],
      "result": "{headless,noGl,noWindow,screen,screenClass,inWorld,player?{...,armor,effects,gamemode,air,...},world?{time,weather,biome,light},server?,nav*,screenshotBackend,...}"
    },
    {
      "name": "auth.status",
      "summary": "current logged-in identity",
      "args": [],
      "result": "{username,uuid,type}"
    },
    {
      "name": "control.rotateToken",
      "summary": "rotate the full-control WebSocket token and persist config",
      "args": [],
      "result": "{rotated,authToken}"
    },
    {
      "name": "connect",
      "summary": "join a server {host, port}",
      "args": [
        {
          "name": "host",
          "type": "string",
          "required": true
        },
        {
          "name": "port",
          "type": "int",
          "required": false,
          "default": "25565"
        }
      ],
      "result": "{connecting,host,port}"
    },
    {
      "name": "disconnect",
      "summary": "leave the current world",
      "args": [],
      "result": "{disconnected}"
    },
    {
      "name": "chat",
      "summary": "send chat, or a /command if prefixed with '/' {message}",
      "args": [
        {
          "name": "message",
          "type": "string",
          "required": true
        }
      ],
      "result": "{sent}"
    },
    {
      "name": "chatHistory",
      "summary": "recent chat lines this bot has seen {limit?=50}",
      "args": [
        {
          "name": "limit",
          "type": "int",
          "required": false,
          "default": "50"
        }
      ],
      "result": "{lines:[{time,kind:chat|system|whisper|team|actionbar,sender?,text}],stored} — an object, not a bare array; oldest line first"
    },
    {
      "name": "whisper",
      "summary": "private-message a player, using whichever command this server has {player, text}",
      "args": [
        {
          "name": "player",
          "type": "string",
          "required": true
        },
        {
          "name": "text",
          "type": "string",
          "required": true
        }
      ],
      "result": "{sent,command,to}"
    },
    {
      "name": "batch",
      "summary": "run commands in order over one round-trip {commands:[{cmd,args}], continueOnError?=false}",
      "args": [
        {
          "name": "commands",
          "type": "object[]",
          "required": true
        },
        {
          "name": "continueOnError",
          "type": "bool",
          "required": false,
          "default": "false"
        }
      ],
      "result": "{results:[{cmd,ok,result?|code,error}],ran,requested}"
    },
    {
      "name": "look",
      "summary": "set view direction {yaw, pitch}",
      "args": [
        {
          "name": "yaw",
          "type": "float",
          "required": false
        },
        {
          "name": "pitch",
          "type": "float",
          "required": false
        }
      ],
      "result": "{yaw,pitch}"
    },
    {
      "name": "lookAt",
      "summary": "point the head at a block or an entity {x,y,z} | {entityId}",
      "args": [
        {
          "name": "x",
          "type": "double",
          "required": false
        },
        {
          "name": "y",
          "type": "double",
          "required": false
        },
        {
          "name": "z",
          "type": "double",
          "required": false
        },
        {
          "name": "entityId",
          "type": "int",
          "required": false
        }
      ],
      "result": "{yaw,pitch,distance}"
    },
    {
      "name": "players",
      "summary": "list tab-list players",
      "args": [],
      "result": "[{name,id,ping}]"
    },
    {
      "name": "headless",
      "summary": "toggle render-skip {enabled?}",
      "args": [
        {
          "name": "enabled",
          "type": "bool",
          "required": false
        }
      ],
      "result": "{headless}"
    },
    {
      "name": "screenshot",
      "summary": "render a PNG -> base64. {x,y,z,yaw,pitch,width,height,fov} for a free camera, {mode:'topdown',centerX,centerZ,radius} for an orthographic map, {annotate:true} to also get the camera and on-screen entity boxes",
      "args": [
        {
          "name": "x",
          "type": "double",
          "required": false
        },
        {
          "name": "y",
          "type": "double",
          "required": false
        },
        {
          "name": "z",
          "type": "double",
          "required": false
        },
        {
          "name": "yaw",
          "type": "float",
          "required": false
        },
        {
          "name": "pitch",
          "type": "float",
          "required": false
        },
        {
          "name": "width",
          "type": "int",
          "required": false
        },
        {
          "name": "height",
          "type": "int",
          "required": false
        },
        {
          "name": "fov",
          "type": "float",
          "required": false
        },
        {
          "name": "mode",
          "type": "string",
          "required": false,
          "default": "normal"
        },
        {
          "name": "centerX",
          "type": "double",
          "required": false
        },
        {
          "name": "centerZ",
          "type": "double",
          "required": false
        },
        {
          "name": "radius",
          "type": "int",
          "required": false,
          "default": "32"
        },
        {
          "name": "annotate",
          "type": "bool",
          "required": false,
          "default": "false"
        }
      ],
      "result": "{format,backend,mode,bytes,width,height,durationMs,snapshotMs,renderMs,pngMs,camera?,entities?:[{id,type,visible,box,depth}],base64}"
    },
    {
      "name": "registry",
      "summary": "ids the running version actually has {kinds?:[blocks,items,entities], tags?=false}",
      "args": [
        {
          "name": "kinds",
          "type": "string[]",
          "required": false
        },
        {
          "name": "tags",
          "type": "bool",
          "required": false,
          "default": "false"
        }
      ],
      "result": "{minecraftVersion,blocks?,items?,entities?,tags?}"
    },
    {
      "name": "goto",
      "summary": "Baritone path to {x,y,z} or {x,z}, within {reach?=1} blocks — completion arrives as nav.done/nav.failed",
      "args": [
        {
          "name": "x",
          "type": "int",
          "required": true
        },
        {
          "name": "z",
          "type": "int",
          "required": true
        },
        {
          "name": "y",
          "type": "int",
          "required": false
        },
        {
          "name": "reach",
          "type": "int",
          "required": false,
          "default": "1"
        }
      ],
      "result": "{pathing,reach,backend}"
    },
    {
      "name": "nav.check",
      "summary": "cheap walkability ESTIMATE — a walk-only A* over loaded chunks, not Baritone. Nothing moves. {x,y,z,reach?=1,maxNodes?}",
      "args": [
        {
          "name": "x",
          "type": "int",
          "required": true
        },
        {
          "name": "y",
          "type": "int",
          "required": true
        },
        {
          "name": "z",
          "type": "int",
          "required": true
        },
        {
          "name": "reach",
          "type": "int",
          "required": false,
          "default": "1"
        },
        {
          "name": "maxNodes",
          "type": "int",
          "required": false
        }
      ],
      "result": "{verdict:reachable|unreachable|unknown,reachable,cost?,nodes,maxNodes,exhausted,model} — an estimate; 'unknown' means the search ran out of budget, NOT that there is no route"
    },
    {
      "name": "baritone",
      "summary": "run any Baritone command (full feature set, if Baritone is installed) {command, collectMs?=250} — returns the lines Baritone printed",
      "args": [
        {
          "name": "command",
          "type": "string",
          "required": true
        },
        {
          "name": "collectMs",
          "type": "int",
          "required": false,
          "default": "250"
        }
      ],
      "result": "{ran,backend,output:[lines Baritone printed]}"
    },
    {
      "name": "nav.stop",
      "summary": "cancel Baritone pathing",
      "args": [],
      "result": "{stopped}"
    },
    {
      "name": "nav.status",
      "summary": "pathfinding availability + state",
      "args": [],
      "result": "{available,backend,active,blockArguments?,goal?}"
    },
